#!/usr/bin/env bash
# The stale report (see khora_stale.py). Usage: bash .claude/scripts/khora-stale [--stdout]
here="$(cd "$(dirname "$0")" && pwd)"
for py in python3 python; do
  if "$py" -c "import sys, yaml; sys.exit(sys.version_info < (3, 8))" >/dev/null 2>&1; then
    exec "$py" "$here/khora_stale.py" "$@"
  fi
done
echo "khora-stale: no Python 3 with PyYAML found" >&2
exit 2
