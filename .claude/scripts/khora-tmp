#!/usr/bin/env bash
# Prints the Obsidian app's temp folder — the root of the khora plugin's queue dirs —
# as a path usable from bash. Never use the agent's own $TMPDIR: the plugin can't see it.
# KHORA_OBSIDIAN_TMP overrides it (e.g. for a Flatpak or Snap Obsidian on Linux).
if [ -n "${KHORA_OBSIDIAN_TMP:-}" ]; then printf '%s\n' "$KHORA_OBSIDIAN_TMP"; exit 0; fi
case "$(uname -s)" in
  Darwin)               getconf DARWIN_USER_TEMP_DIR | sed 's:/*$::' ;;
  MINGW*|MSYS*|CYGWIN*) cygpath -u "${LOCALAPPDATA}\Temp" ;;   # Git Bash's own $TEMP is /tmp — wrong dir
  *)                    printf '/tmp\n' ;;   # Linux: obsidian-headless.sh starts Obsidian with TMPDIR=/tmp
esac
